# ===========================================================================
# FORMATOR AI - Variables d'environnement
# ---------------------------------------------------------------------------
# Copiez ce fichier en .env.local et renseignez vos cles.
# L'application fonctionne SANS cles (mode demo / contenu simule),
# mais la generation IA reelle necessite au moins une cle ci-dessous.
# ===========================================================================

# --- IA (au moins une des deux recommandee) ---
# Cle API Claude (Anthropic) - fournisseur prioritaire
ANTHROPIC_API_KEY=

# Cle API OpenAI - utilisee en repli si Anthropic absente
OPENAI_API_KEY=

# Modele Claude a utiliser (optionnel)
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Supabase (optionnel, pour la persistance serveur en production) ---
# En V1, l'app persiste les donnees dans le navigateur (localStorage).
# Renseignez ces cles pour activer la persistance Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
